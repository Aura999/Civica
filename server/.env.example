# JWT Secret Key used for signing and verifying JSON Web Tokens
JWT_SECRET=

# MongoDB connection string for connecting to the database
MONGODB_URL=

# Hostname of the mail server used for sending emails
MAIL_HOST=

# Username of the email account used for sending emails
MAIL_USER=

# Password of the email account used for sending emails
MAIL_PASS=

# Backend server port
PORT=

# Allowed frontend origins for CORS
FRONTEND_URL=
PRODUCTION_FRONTEND_URL=

# Cloudinary media upload configuration
CLOUD_NAME=
API_KEY=
API_SECRET=
FOLDER_NAME=civica

# Razorpay payment configuration
RAZORPAY_KEY=
RAZORPAY_SECRET=

# Resend API key used by the current mail utility
RESEND_API_KEY=

# Optional maintenance script token
SYNC_CATEGORIES_TOKEN=
